        // address  data  operate
7F      // 0        7F    mov B, 15
90      // 1        90    OUT B
3D      // 2        3D    MOV A, 13
01      // 3        01    ADD A, 1
E3      // 4        E3    JNC    3
51      // 5        51    ADD B, 1
E1      // 6        E1    JNC    1
B0      // 7        B0    OUT    0
BF      // 8        BF    OUT    15
F7      // 9        F7    JMP    7
00      // 10       00    NOP (ADD A, 0x0)
00      // 11       00    NOP (ADD A, 0x0)
00      // 12       00    NOP (ADD A, 0x0)
00      // 13       00    NOP (ADD A, 0x0)
00      // 14       00    NOP (ADD A, 0x0)
00      // 15       00    NOP (ADD A, 0x0)